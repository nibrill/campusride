rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Cada usuario solo puede leer y escribir su propio perfil.
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
    }

    match /trips/{tripId} {
      allow read: if signedIn();

      // Solo conductores pueden publicar, y siempre a su nombre.
      allow create: if signedIn()
        && request.resource.data.driverId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'
        && request.resource.data.passengers.size() == 0
        && request.resource.data.seats is int
        && request.resource.data.seats >= 1 && request.resource.data.seats <= 8;

      // El conductor edita su viaje; los pasajeros solo modifican la lista `passengers`
      // sin superar el cupo.
      allow update: if signedIn() && (
        resource.data.driverId == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passengers'])
          && request.resource.data.passengers.size() <= resource.data.seats
        )
      );

      allow delete: if signedIn() && resource.data.driverId == request.auth.uid;
    }
  }
}
